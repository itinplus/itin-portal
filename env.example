# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ─── Stripe ─────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create in Stripe dashboard)
STRIPE_PRICE_ITIN_NEW=price_...
STRIPE_PRICE_ITIN_RENEWAL=price_...
STRIPE_PRICE_ITIN_TAX_RETURN=price_...
STRIPE_PRICE_ITIN_DEPENDENT=price_...
STRIPE_PRICE_ITIN_LLC=price_...
STRIPE_PRICE_EIN_ADDON=price_...

# ─── Resend (email) ──────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=ITIN Plus <no-reply@itinplus.com>
EMAIL_REPLY_TO=apply@itinplus.com

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://portal.itinplus.com
NEXT_PUBLIC_COMPANY_NAME=ITIN Plus Inc.
NEXT_PUBLIC_SUPPORT_EMAIL=apply@itinplus.com
NEXT_PUBLIC_WHATSAPP=+13052166992

# ─── Security ───────────────────────────────────────────────
ENCRYPTION_KEY=32_char_random_string_here_12345
NEXTAUTH_SECRET=your_nextauth_secret_here

# ─── Feature flags ──────────────────────────────────────────
NEXT_PUBLIC_ENABLE_WHATSAPP_NOTIFICATIONS=false
NEXT_PUBLIC_ENABLE_ESIGNATURE=false
